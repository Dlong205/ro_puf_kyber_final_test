# Vivado projects and generated products
build/
# Routed DCPs are 25-30 MB each and reproducible via the build scripts +
# frozen macro DCP; keep BITs, fingerprints, reports and freeze manifests.
reports/**/*routed.dcp
# Sim I/O hexes derived from private enrollment material (response/helper/
# key/KCV) must never be committed; regenerate via enroll scripts + sim.
sim/puf64_enroll/*.hex
# Firmware build artifacts (keep committed .hex inputs + sources only).
firmware/*.bin
firmware/*.elf
release/
.Xil/
*.jou
*.log
*.pb
*.wdb
*.vcd
*.str
webtalk*.jou
webtalk*.log
usage_statistics_webtalk.*

# Verilator and generated simulation sources
sim/*/obj_dir*/
sim/fuzzy_extractor/rtl_tcq0/
sim/fuzzy_extractor/tb_fuzzy_extractor_main.cpp

# Firmware intermediates; firmware.hex is intentionally tracked
firmware/firmware.bin
firmware/firmware.elf
firmware/.mode_*
# Diagnostic bring-up image (build artifact; used only by the full-system sim)
firmware/firmware_diag.bin
firmware/firmware_diag.elf
firmware/firmware_diag.hex

# Local board enrollment artifacts and caches
helper.bin
hardware_helper.bin
*.helper.bin
# Per-device RO-PUF margin data is a physical fingerprint.  Keep raw/private
# characterization campaigns local; only aggregate, non-identifying summaries
# belong in the public repository.
reports/puf_characterization/private_*.json
reports/puf_allpairs_characterization/private_*.json
reports/puf_allpairs64_characterization/private_*.json
reports/puf_mapping/private_*.json
reports/puf64_campaign/
reports/puf64_macrov2_campaign/*_private.json
reports/puf64_macrov2_campaign/private_*.json
reports/puf64_macrov2_campaign/*.helper_record
reports/puf64_macrov2_campaign/*.record
reports/puf64_macrov2_campaign/*.bin
reports/puf64_operational_native_campaign/
reports/puf64_finalchar_campaign/
**/__pycache__/
*.py[cod]

# Editor/OS noise
.DS_Store
*~
*.swp
