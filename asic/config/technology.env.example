# Copy values into your shell or a private, untracked environment file.
# Never commit licensed PDK/library contents or credentials.
export ASIC_PDK_NAME=UNSET
export ASIC_PDK_VERSION=UNSET
export ASIC_PDK_ROOT=/absolute/path/to/pdk
export ASIC_LIBERTY_FILE=/absolute/path/to/standard_cells.lib
export ASIC_TECH_LEF=/absolute/path/to/technology.lef
export ASIC_CELL_LEF=/absolute/path/to/standard_cells.lef

# Add these after the RO macro is implemented/characterized.
export ASIC_RO_LIBERTY=/absolute/path/to/kp_asic_ro_macro.lib
export ASIC_RO_LEF=/absolute/path/to/kp_asic_ro_macro.lef
export ASIC_RO_GDS=/absolute/path/to/kp_asic_ro_macro.gds
