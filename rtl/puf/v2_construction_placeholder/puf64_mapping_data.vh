// CONSTRUCTION PLACEHOLDER -- NON-RELEASE -- NEVER PROGRAM -- NEVER QUALIFY.
// R5-shell construction only: lets the operational-V2 project elaborate and
// prove macro import/timing/fingerprint flow before R4 produces the real
// mapping.  Identity entries, tag 0x0000, zero digests.  Any program,
// release, freeze or qualification flow referencing this file must fail
// (see scripts/check_operational_v2_construction.py).  The golden
// puf64_mapping_data.vh is untouched; this file shadows it ONLY via the
// shell project's include_dirs order.
localparam integer PUF64_MAP_LEN_BITS   = 264;
localparam integer PUF64_MAP_LEN_BYTES  = 33;
localparam integer PUF64_MAP_PAIR_COUNT = 264;
localparam [15:0]  PUF64_MAP_TAG        = 16'h0000;
localparam [255:0] PUF64_MAP_DIGEST_SHA3_256 = 256'h0;
localparam [255:0] PUF64_MAP_SELECTION_SHA256 = 256'h0;
localparam [3167:0] PUF64_MAP_PAIRS = 3168';
localparam [2903:0] PUF64_MAP_SORTED_FULL = 2904';
localparam [2375:0] PUF64_MAP_SORTED_DEST = 2376';
function automatic [10:0] puf64_map_sorted_full(input integer j);
    puf64_map_sorted_full = PUF64_MAP_SORTED_FULL[2904-1 - 11*j -: 11];
endfunction
function automatic [8:0] puf64_map_sorted_dest(input integer j);
    puf64_map_sorted_dest = PUF64_MAP_SORTED_DEST[2376-1 - 9*j -: 9];
endfunction
function automatic [5:0] puf64_map_pair_a(input integer j);
    puf64_map_pair_a = PUF64_MAP_PAIRS[3168-1 - 12*j -: 6];
endfunction
function automatic [5:0] puf64_map_pair_b(input integer j);
    puf64_map_pair_b = PUF64_MAP_PAIRS[3168-1 - 12*j - 6 -: 6];
endfunction
